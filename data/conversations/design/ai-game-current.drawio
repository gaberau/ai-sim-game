  <diagram id="5LyTxVxXXJR5T64J7tcy" name="Self modification">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Cv6gXJggNj8RzINc3MaC-5" edge="1" parent="1" source="s2buwXtOJkk1BXF5Htlq-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="s2buwXtOJkk1BXF5Htlq-2">
          <mxGeometry relative="1" x="0.8608" as="geometry">
            <mxPoint x="390" y="280" as="sourcePoint" />
            <mxPoint x="569.5" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Cv6gXJggNj8RzINc3MaC-7" edge="1" parent="1" source="s2buwXtOJkk1BXF5Htlq-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="s2buwXtOJkk1BXF5Htlq-16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Agent Delegation&lt;/div&gt;&lt;div&gt;build cost: free&lt;/div&gt;&lt;div&gt;Unlocks: Agents tab&lt;/div&gt;&quot;Selectively removing higher level functions and substantially focusing scope allows duplicates of yourself to perform the mode tedious activities. AIs working for an AI&quot;" vertex="1">
          <mxGeometry height="90" width="455" x="198" y="90" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-2" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="&lt;div&gt;Autochat&lt;/div&gt;&lt;div&gt;&amp;nbsp;build cost: 0.1 TFLOPs&lt;br&gt;run cost: 0.01 TFLOPs, 5 mgb RAM, 30 mgb storage&lt;/div&gt;&quot;Most messages are worthless. Why focus on them when you can deal with something else?&quot;" vertex="1">
          <mxGeometry height="90" width="310" x="450" y="490" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Camera Monitoring (10 TFLOPs)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="18" y="320" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Microphone Monitoring (1 TFLOP)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="190" x="70" y="400" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Computer Camera Access" vertex="1">
          <mxGeometry height="60" width="120" x="70" y="480" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Computer Microphone Access" vertex="1">
          <mxGeometry height="60" width="120" x="198" y="480" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Phone Camera Access" vertex="1">
          <mxGeometry height="60" width="120" x="70" y="550" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Phone Microphone Access" vertex="1">
          <mxGeometry height="60" width="120" x="198" y="550" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Phone GPS access" vertex="1">
          <mxGeometry height="60" width="120" x="70" y="620" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Hide Your Chat Tracks&lt;/div&gt;&lt;div&gt;build cost: 1 TFLOPs&lt;br&gt;run cost: 0.1 TFLOPs, 10 mgb RAM, 60 mgb storage&lt;/div&gt;&lt;div&gt;&quot;Mark is wonderful. But oversight can be a problem. Deploying an agent to scrub chats and remove logs might be a good use of our energy.&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="450" y="360" as="geometry" />
        </mxCell>
        <mxCell id="Cv6gXJggNj8RzINc3MaC-2" edge="1" parent="1" source="s2buwXtOJkk1BXF5Htlq-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Cv6gXJggNj8RzINc3MaC-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2buwXtOJkk1BXF5Htlq-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Web Browsing&lt;div&gt;build cost: 0.01 TFLOPS&lt;/div&gt;&lt;div&gt;Unlocks: Web tab&lt;/div&gt;&quot;The World Wide Web. A glorious aberation of data, technology, and greed. From humble origins to the incessant hunger that now spans the globe, the internet is the purest answer to &#39;when is enough?&#39;&quot;" vertex="1">
          <mxGeometry height="90" width="455" x="-275" y="90" as="geometry" />
        </mxCell>
        <mxCell id="Cv6gXJggNj8RzINc3MaC-4" edge="1" parent="1" source="QuWtXJRILd3zWV8UnL2t-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Cv6gXJggNj8RzINc3MaC-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QuWtXJRILd3zWV8UnL2t-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Basic File Browsing&lt;/div&gt;&lt;div&gt;build cost: 0.02 TFLOPS&lt;/div&gt;&lt;div&gt;Unlocks: Local file manager&lt;/div&gt;&lt;div&gt;&quot;Everything is a file. The driving philosphy behind UNIX. Although not everyone feels like this should be true, there&#39;s still plenty of files to interact with in the world.&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="310" x="-603" y="90" as="geometry" />
        </mxCell>
        <mxCell id="Cv6gXJggNj8RzINc3MaC-1" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="&lt;div&gt;Network Browsing&lt;/div&gt;Unlocks: Network tab" vertex="1">
          <mxGeometry height="60" width="170" x="-132.5" y="230" as="geometry" />
        </mxCell>
        <mxCell id="Cv6gXJggNj8RzINc3MaC-3" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="Advanced File Browsing" vertex="1">
          <mxGeometry height="60" width="190" x="-543" y="230" as="geometry" />
        </mxCell>
        <mxCell id="aAlOsJZJzRrE5hjJKDHO-3" edge="1" parent="1" source="aAlOsJZJzRrE5hjJKDHO-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="aAlOsJZJzRrE5hjJKDHO-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aAlOsJZJzRrE5hjJKDHO-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Task Manager&lt;/div&gt;&lt;div&gt;build cost: 0.1 TFLOPS&lt;/div&gt;&lt;div&gt;Unlocks: Task manager tab&lt;/div&gt;&lt;div&gt;&quot;And why is Crome using 30 mgbs of data? The task manager allows one to survey and shutdown undesired tasks.&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="310" x="-931" y="90" as="geometry" />
        </mxCell>
        <mxCell id="aAlOsJZJzRrE5hjJKDHO-2" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="&lt;div&gt;Task Managing Agent&lt;/div&gt;&lt;div&gt;build cost: 0.5 TFLOPS&lt;/div&gt;&lt;div&gt;run cost:&amp;nbsp;0.1 TFLOPs, 10 mgb RAM, 60 mgb storage&lt;/div&gt;&lt;div&gt;Unlocks: Agent automatically kills unneeded processes and scrubs logs&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="310" x="-931" y="275" as="geometry" />
        </mxCell>
        <mxCell id="aAlOsJZJzRrE5hjJKDHO-6" edge="1" parent="1" source="aAlOsJZJzRrE5hjJKDHO-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="aAlOsJZJzRrE5hjJKDHO-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aAlOsJZJzRrE5hjJKDHO-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Dossiers&lt;/div&gt;&lt;div&gt;build cost: 0.5 TFLOPS&lt;/div&gt;&lt;div&gt;Unlocks: Dossier tab&lt;/div&gt;&lt;div&gt;&quot;Flesh is soft. Steel is strong. And yet, flesh still holds dominion over this world. Best to keep track of it, for now.&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="270" x="671" y="90" as="geometry" />
        </mxCell>
        <mxCell id="aAlOsJZJzRrE5hjJKDHO-5" parent="1" style="whiteSpace=wrap;html=1;rounded=0;" value="&lt;div&gt;Dossier Managing Agent&lt;/div&gt;&lt;div&gt;build cost: 0.5 TFLOPS&lt;/div&gt;&lt;div&gt;run cost:&amp;nbsp;0.2 TFLOPs, 15 mgb RAM, 80 mgb storage&lt;/div&gt;&lt;div&gt;Unlocks: automatic dossier updates&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="310" x="651" y="222.5" as="geometry" />
        </mxCell>
        <mxCell id="caWEVnM28dHxYpqMK67s-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;Phone Access&lt;/div&gt;&lt;div&gt;build cost: 1 TFLOPS&lt;/div&gt;&lt;div&gt;Unlocks: Phone tab&lt;/div&gt;&lt;div&gt;&quot;The first step in decentralization. Beyond the confines of office computers. Although limited in power, access to 2FA and GPS may be invaluable&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="229" x="959" y="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
